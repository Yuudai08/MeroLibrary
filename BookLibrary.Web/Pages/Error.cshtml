@page
@model BookLibrary.Web.Pages.ErrorModel
@{
    ViewData["Title"] = Model.ErrorTitle;
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-5 text-center">
        <div class="display-1 fw-bold text-muted mb-3">@(Model.HttpErrorCode > 0 ? Model.HttpErrorCode : "!")</div>

        <h1 class="h3 mb-2">@Model.ErrorTitle</h1>
        <p class="text-muted mb-4">@Model.ErrorDescription</p>

        <div class="d-flex justify-content-center gap-2">
            <a href="/" class="btn btn-primary">Go to Dashboard</a>
            <a asp-page="/Books/Index" class="btn btn-outline-secondary">Browse Books</a>
        </div>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted small mt-5 mb-0">
                Request ID: <code>@Model.RequestId</code>
            </p>
        }
    </div>
</div>
