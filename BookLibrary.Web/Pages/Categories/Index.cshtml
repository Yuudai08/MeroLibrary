@page
@model BookLibrary.Web.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Categories</h1>
        <p class="text-muted mb-0">Manage book categories and genres</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">
        + Add New Category
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Categories.Any())
{
    <div class="text-center py-5 border rounded bg-light">
        <h4 class="h5 text-secondary">No categories found</h4>
        <p class="text-muted mb-3">There are currently no categories registered in the system.</p>
        <a asp-page="Create" class="btn btn-sm btn-outline-primary">+ Add a Category</a>
    </div>
}
else
{
    <div class="table-responsive bg-white rounded shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" style="width: 80px;">ID</th>
                    <th scope="col">Category Name</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.Categories)
                {
                    <tr>
                        <td><code class="text-muted">#@category.Id</code></td>
                        <td class="fw-semibold">
                            <a asp-page="Details" asp-route-id="@category.Id" class="text-decoration-none text-dark">
                                @category.Name
                            </a>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-page="Details" asp-route-id="@category.Id" class="btn btn-outline-secondary" title="View Details & Books">Details</a>
                                <a asp-page="Edit" asp-route-id="@category.Id" class="btn btn-outline-primary" title="Edit Category">Edit</a>
                                <a asp-page="Delete" asp-route-id="@category.Id" class="btn btn-outline-danger" title="Delete Category">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
