@page "{id:int}"
@model BookLibrary.Web.Pages.Categories.DeleteModel
@{
    ViewData["Title"] = "Delete Category";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a asp-page="Index" class="btn btn-outline-secondary btn-sm me-3">&larr; Back to Categories</a>
            <h1 class="h3 text-danger mb-0">Confirm Delete Category</h1>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (Model.Category != null)
        {
            <div class="card border-danger shadow-sm mb-4">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 text-white">Are you sure you want to delete this category?</h5>
                </div>
                <div class="card-body p-4">
                    <h4 class="h5 card-title mb-3">Category: @Model.Category.Name (ID: #@Model.Category.Id)</h4>

                    @if (Model.Books.Any())
                    {
                        <div class="alert alert-warning border-warning" role="alert">
                            <h6 class="alert-heading fw-bold">Category Cannot Be Deleted Directly</h6>
                            <p class="mb-2">This category is currently assigned to <strong>@Model.Books.Count book(s)</strong>:</p>
                            <ul class="mb-2 small">
                                @foreach (var b in Model.Books.Take(5))
                                {
                                    <li>@b.Title (Author: @b.AuthorName)</li>
                                }
                                @if (Model.Books.Count > 5)
                                {
                                    <li><em>...and @(Model.Books.Count - 5) more.</em></li>
                                }
                            </ul>
                            <p class="mb-0 small text-dark">Please reassign or delete these books before deleting this category.</p>
                        </div>
                    }
                </div>
                <div class="card-footer bg-light d-flex justify-content-end gap-2 p-3">
                    <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                    <form method="post">
                        <button type="submit" class="btn btn-danger px-4" @(Model.Books.Any() ? "disabled" : "")>Delete Category</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
