@page
@model BookLibrary.Web.Pages.Authors.IndexModel
@{
    ViewData["Title"] = "Authors";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Authors</h1>
        <p class="text-muted mb-0">Manage authors in the library system</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">
        + Add New Author
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Authors.Any())
{
    <div class="text-center py-5 border rounded bg-light">
        <h4 class="h5 text-secondary">No authors found</h4>
        <p class="text-muted mb-3">There are currently no authors registered in the library.</p>
        <a asp-page="Create" class="btn btn-sm btn-outline-primary">+ Add an Author</a>
    </div>
}
else
{
    <div class="table-responsive bg-white rounded shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Biography</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var author in Model.Authors)
                {
                    <tr>
                        <td class="fw-semibold">
                            <a asp-page="Details" asp-route-id="@author.Id" class="text-decoration-none text-dark">
                                @author.Name
                            </a>
                        </td>
                        <td class="text-muted text-truncate" style="max-width: 400px;">
                            @(string.IsNullOrWhiteSpace(author.Biography) ? "No biography provided." : author.Biography)
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-page="Details" asp-route-id="@author.Id" class="btn btn-outline-secondary" title="View Details & Books">Details</a>
                                <a asp-page="Edit" asp-route-id="@author.Id" class="btn btn-outline-primary" title="Edit Author">Edit</a>
                                <a asp-page="Delete" asp-route-id="@author.Id" class="btn btn-outline-danger" title="Delete Author">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
