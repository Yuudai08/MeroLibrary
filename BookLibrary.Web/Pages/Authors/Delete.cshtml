@page "{id:int}"
@model BookLibrary.Web.Pages.Authors.DeleteModel
@{
    ViewData["Title"] = "Delete Author";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a asp-page="Index" class="btn btn-outline-secondary btn-sm me-3">&larr; Back to Authors</a>
            <h1 class="h3 text-danger mb-0">Confirm Delete Author</h1>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (Model.Author != null)
        {
            <div class="card border-danger shadow-sm mb-4">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 text-white">Are you sure you want to delete this author?</h5>
                </div>
                <div class="card-body p-4">
                    <h4 class="h5 card-title mb-2">@Model.Author.Name</h4>
                    <p class="text-muted small mb-3">@(string.IsNullOrWhiteSpace(Model.Author.Biography) ? "No biography recorded." : Model.Author.Biography)</p>

                    @if (Model.Books.Any())
                    {
                        <div class="alert alert-warning border-warning" role="alert">
                            <h6 class="alert-heading fw-bold">Warning: Associated Books Found</h6>
                            <p class="mb-2">This author has <strong>@Model.Books.Count book(s)</strong> registered in the library:</p>
                            <ul class="mb-2 small">
                                @foreach (var b in Model.Books.Take(5))
                                {
                                    <li>@b.Title (ISBN: @b.ISBN)</li>
                                }
                                @if (Model.Books.Count > 5)
                                {
                                    <li><em>...and @(Model.Books.Count - 5) more.</em></li>
                                }
                            </ul>
                            <p class="mb-0 small text-dark">Standard deletion will fail due to database foreign key constraints. You can use <strong>Delete Author with Books</strong> to atomically remove the author and all their books in a single transaction.</p>
                        </div>
                    }
                </div>
                <div class="card-footer bg-light d-flex justify-content-end gap-2 p-3">
                    <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>

                    @if (Model.Books.Any())
                    {
                        <form method="post" asp-page-handler="DeleteWithBooks">
                            <button type="submit" class="btn btn-danger">Delete Author & All @Model.Books.Count Books</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="DeleteStandard">
                            <button type="submit" class="btn btn-danger px-4">Delete Author</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>
