@page "{id:int}"
@model BookLibrary.Web.Pages.Authors.DetailsModel
@{
    ViewData["Title"] = Model.Author?.Name ?? "Author Details";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        <div class="d-flex align-items-center mb-4">
            <a asp-page="Index" class="btn btn-outline-secondary btn-sm me-3">&larr; Back to Authors</a>
            <h1 class="h3 mb-0">Author Profile</h1>
        </div>

        @if (Model.Author != null)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h2 class="h4 card-title mb-0">@Model.Author.Name</h2>
                        <div class="btn-group btn-group-sm">
                            <a asp-page="Edit" asp-route-id="@Model.Author.Id" class="btn btn-outline-primary">Edit Author</a>
                            <a asp-page="Delete" asp-route-id="@Model.Author.Id" class="btn btn-outline-danger">Delete Author</a>
                        </div>
                    </div>

                    <div class="mb-3">
                        <h6 class="text-muted text-uppercase small font-monospace">Biography</h6>
                        <p class="mb-0 text-secondary" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(Model.Author.Biography) ? "No biography recorded for this author." : Model.Author.Biography)</p>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="h5 mb-0">Books by @Model.Author.Name (@Model.Books.Count)</h3>
                <a asp-page="/Books/Create" class="btn btn-sm btn-outline-primary">+ Add Book</a>
            </div>

            @if (!Model.Books.Any())
            {
                <div class="text-center py-4 border rounded bg-light">
                    <p class="text-muted mb-0">No books by this author are currently registered in the library.</p>
                </div>
            }
            else
            {
                <div class="table-responsive bg-white rounded shadow-sm border">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Title</th>
                                <th scope="col">ISBN</th>
                                <th scope="col">Category</th>
                                <th scope="col">Year</th>
                                <th scope="col">Status</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var book in Model.Books)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        <a asp-page="/Books/Details" asp-route-id="@book.Id" class="text-decoration-none text-dark">
                                            @book.Title
                                        </a>
                                    </td>
                                    <td><code class="text-muted">@book.ISBN</code></td>
                                    <td><span class="badge bg-light text-dark border">@book.CategoryName</span></td>
                                    <td>@book.PublishedYear</td>
                                    <td>
                                        @switch (book.Status)
                                        {
                                            case BookLibrary.Web.Models.BookStatus.WantToRead:
                                                <span class="badge bg-secondary">Want to Read</span>
                                                break;
                                            case BookLibrary.Web.Models.BookStatus.Reading:
                                                <span class="badge bg-info text-dark">Reading</span>
                                                break;
                                            case BookLibrary.Web.Models.BookStatus.Completed:
                                                <span class="badge bg-success">Completed</span>
                                                break;
                                            case BookLibrary.Web.Models.BookStatus.Dropped:
                                                <span class="badge bg-danger">Dropped</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-page="/Books/Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-secondary">View Book</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>
