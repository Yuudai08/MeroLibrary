@page
@model BookLibrary.Web.Pages.Books.CreateModel
@{
    ViewData["Title"] = "Add New Book";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a asp-page="Index" class="btn btn-outline-secondary btn-sm me-3">&larr; Back to Books</a>
            <h1 class="h3 mb-0">Add New Book</h1>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Title" class="form-label fw-semibold"></label>
                        <input asp-for="Input.Title" class="form-control" placeholder="e.g. Clean Code" />
                        <span asp-validation-for="Input.Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.ISBN" class="form-label fw-semibold"></label>
                        <input asp-for="Input.ISBN" class="form-control" placeholder="e.g. 978-0132350884" />
                        <span asp-validation-for="Input.ISBN" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label asp-for="Input.AuthorId" class="form-label fw-semibold mb-0"></label>
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none small fw-semibold" data-bs-toggle="modal" data-bs-target="#quickAddAuthorModal">
                                    + Add New Author
                                </button>
                            </div>
                            <select asp-for="Input.AuthorId" id="authorSelect" asp-items="Model.AuthorsList" class="form-select">
                                <option value="">-- Select Author --</option>
                                <option value="__add_new__" class="text-primary fw-bold">+ Add New Author...</option>
                            </select>
                            <span asp-validation-for="Input.AuthorId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label asp-for="Input.CategoryId" class="form-label fw-semibold mb-0"></label>
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none small fw-semibold" data-bs-toggle="modal" data-bs-target="#quickAddCategoryModal">
                                    + Add New Category
                                </button>
                            </div>
                            <select asp-for="Input.CategoryId" id="categorySelect" asp-items="Model.CategoriesList" class="form-select">
                                <option value="">-- Select Category --</option>
                                <option value="__add_new__" class="text-primary fw-bold">+ Add New Category...</option>
                            </select>
                            <span asp-validation-for="Input.CategoryId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.PublishedYear" class="form-label fw-semibold"></label>
                            <input asp-for="Input.PublishedYear" class="form-control" type="number" />
                            <span asp-validation-for="Input.PublishedYear" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.Status" class="form-label fw-semibold"></label>
                            <select asp-for="Input.Status" id="statusSelect" asp-items="Html.GetEnumSelectList<BookLibrary.Web.Models.BookStatus>()" class="form-select">
                            </select>
                            <span asp-validation-for="Input.Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.BookNumber" class="form-label fw-semibold" id="bookNumberLabel">
                            Book Number <span class="text-muted fw-normal small">(Optional)</span>
                        </label>
                        <input asp-for="Input.BookNumber" id="bookNumberInput" class="form-control" type="number" min="1" placeholder="e.g. 1, 2, 3..." />
                        <div class="form-text small" id="bookNumberHelp">
                            Optional: track the book number of the book you are currently reading or part of a series.
                        </div>
                        <span asp-validation-for="Input.BookNumber" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Create Book</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Quick Add Author Modal -->
<div class="modal fade" id="quickAddAuthorModal" tabindex="-1" aria-labelledby="quickAddAuthorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="quickAddAuthorModalLabel">Add New Author</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="authorModalAlert" class="alert alert-danger d-none small py-2" role="alert"></div>
                <div class="mb-3">
                    <label for="newAuthorName" class="form-label fw-semibold small">Author Name <span class="text-danger">*</span></label>
                    <input type="text" id="newAuthorName" class="form-control" placeholder="e.g. Andy Weir" />
                </div>
                <div class="mb-3">
                    <label for="newAuthorBio" class="form-label fw-semibold small">Biography (Optional)</label>
                    <textarea id="newAuthorBio" class="form-control" rows="3" placeholder="Brief biographical notes..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnSaveQuickAuthor" class="btn btn-primary btn-sm px-3">Save & Select</button>
            </div>
        </div>
    </div>
</div>

<!-- Quick Add Category Modal -->
<div class="modal fade" id="quickAddCategoryModal" tabindex="-1" aria-labelledby="quickAddCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="quickAddCategoryModalLabel">Add New Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="categoryModalAlert" class="alert alert-danger d-none small py-2" role="alert"></div>
                <div class="mb-3">
                    <label for="newCategoryName" class="form-label fw-semibold small">Category Name <span class="text-danger">*</span></label>
                    <input type="text" id="newCategoryName" class="form-control" placeholder="e.g. Science Fiction, Biography" />
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnSaveQuickCategory" class="btn btn-primary btn-sm px-3">Save & Select</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const statusSelect = document.getElementById('statusSelect');
            const bookNumberInput = document.getElementById('bookNumberInput');
            const bookNumberHelp = document.getElementById('bookNumberHelp');

            const authorSelect = document.getElementById('authorSelect');
            const quickAuthorModalEl = document.getElementById('quickAddAuthorModal');
            const quickAuthorModal = quickAuthorModalEl ? new bootstrap.Modal(quickAuthorModalEl) : null;
            const btnSaveQuickAuthor = document.getElementById('btnSaveQuickAuthor');
            const newAuthorName = document.getElementById('newAuthorName');
            const newAuthorBio = document.getElementById('newAuthorBio');
            const authorModalAlert = document.getElementById('authorModalAlert');

            const categorySelect = document.getElementById('categorySelect');
            const quickCategoryModalEl = document.getElementById('quickAddCategoryModal');
            const quickCategoryModal = quickCategoryModalEl ? new bootstrap.Modal(quickCategoryModalEl) : null;
            const btnSaveQuickCategory = document.getElementById('btnSaveQuickCategory');
            const newCategoryName = document.getElementById('newCategoryName');
            const categoryModalAlert = document.getElementById('categoryModalAlert');

            // 1. Conditional Book Number: only enabled when Status is 'Reading' (1) or 'Dropped' (3)
            function updateBookNumberState() {
                // BookStatus: 0 = WantToRead, 1 = Reading, 2 = Completed, 3 = Dropped
                const val = statusSelect.value;
                const isReadingOrDropped = (val === '1' || val === '3' || val === 'Reading' || val === 'Dropped');

                if (isReadingOrDropped) {
                    bookNumberInput.disabled = false;
                    bookNumberInput.placeholder = 'e.g. 1, 2, 3...';
                    bookNumberHelp.className = 'form-text small text-muted';
                    bookNumberHelp.innerHTML = 'Active: Enter the book number for this book you are reading or dropped.';
                } else {
                    bookNumberInput.disabled = true;
                    bookNumberInput.value = '';
                    bookNumberInput.placeholder = "Disabled: Only available when Status is 'Reading' or 'Dropped'";
                    bookNumberHelp.className = 'form-text small text-secondary';
                    bookNumberHelp.innerHTML = '<span class="text-secondary fw-semibold">&#9432; Book number is only available when Status is "Reading" or "Dropped".</span>';
                }
            }

            statusSelect.addEventListener('change', updateBookNumberState);
            updateBookNumberState();

            // 2. Dropdown "+ Add New Author..." trigger
            let previousAuthorValue = authorSelect.value;
            authorSelect.addEventListener('change', function () {
                if (this.value === '__add_new__') {
                    this.value = previousAuthorValue;
                    if (quickAuthorModal) {
                        quickAuthorModal.show();
                    }
                } else {
                    previousAuthorValue = this.value;
                }
            });

            // 3. Quick Author creation via AJAX
            btnSaveQuickAuthor?.addEventListener('click', async function () {
                const name = newAuthorName.value.trim();
                const bio = newAuthorBio.value.trim();

                authorModalAlert.classList.add('d-none');
                authorModalAlert.textContent = '';

                if (!name) {
                    authorModalAlert.textContent = 'Author name is required.';
                    authorModalAlert.classList.remove('d-none');
                    newAuthorName.focus();
                    return;
                }

                btnSaveQuickAuthor.disabled = true;
                btnSaveQuickAuthor.textContent = 'Saving...';

                try {
                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    const token = tokenInput ? tokenInput.value : '';

                    const response = await fetch('?handler=QuickCreateAuthor', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ name: name, biography: bio || null })
                    });

                    if (!response.ok) {
                        const err = await response.json().catch(() => ({ message: 'Failed to create author.' }));
                        throw new Error(err.message || 'Failed to create author.');
                    }

                    const created = await response.json();

                    const newOption = document.createElement('option');
                    newOption.value = created.id;
                    newOption.textContent = created.name;
                    newOption.selected = true;

                    const addNewOpt = authorSelect.querySelector('option[value="__add_new__"]');
                    if (addNewOpt) {
                        authorSelect.insertBefore(newOption, addNewOpt);
                    } else {
                        authorSelect.appendChild(newOption);
                    }

                    authorSelect.value = created.id;
                    previousAuthorValue = created.id;

                    newAuthorName.value = '';
                    newAuthorBio.value = '';
                    if (quickAuthorModal) {
                        quickAuthorModal.hide();
                    }
                } catch (err) {
                    authorModalAlert.textContent = err.message;
                    authorModalAlert.classList.remove('d-none');
                } finally {
                    btnSaveQuickAuthor.disabled = false;
                    btnSaveQuickAuthor.textContent = 'Save & Select';
                }
            });

            // 4. Dropdown "+ Add New Category..." trigger
            let previousCategoryValue = categorySelect.value;
            categorySelect.addEventListener('change', function () {
                if (this.value === '__add_new__') {
                    this.value = previousCategoryValue;
                    if (quickCategoryModal) {
                        quickCategoryModal.show();
                    }
                } else {
                    previousCategoryValue = this.value;
                }
            });

            // 5. Quick Category creation via AJAX
            btnSaveQuickCategory?.addEventListener('click', async function () {
                const name = newCategoryName.value.trim();

                categoryModalAlert.classList.add('d-none');
                categoryModalAlert.textContent = '';

                if (!name) {
                    categoryModalAlert.textContent = 'Category name is required.';
                    categoryModalAlert.classList.remove('d-none');
                    newCategoryName.focus();
                    return;
                }

                btnSaveQuickCategory.disabled = true;
                btnSaveQuickCategory.textContent = 'Saving...';

                try {
                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    const token = tokenInput ? tokenInput.value : '';

                    const response = await fetch('?handler=QuickCreateCategory', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ name: name })
                    });

                    if (!response.ok) {
                        const err = await response.json().catch(() => ({ message: 'Failed to create category.' }));
                        throw new Error(err.message || 'Failed to create category.');
                    }

                    const created = await response.json();

                    const newOption = document.createElement('option');
                    newOption.value = created.id;
                    newOption.textContent = created.name;
                    newOption.selected = true;

                    const addNewOpt = categorySelect.querySelector('option[value="__add_new__"]');
                    if (addNewOpt) {
                        categorySelect.insertBefore(newOption, addNewOpt);
                    } else {
                        categorySelect.appendChild(newOption);
                    }

                    categorySelect.value = created.id;
                    previousCategoryValue = created.id;

                    newCategoryName.value = '';
                    if (quickCategoryModal) {
                        quickCategoryModal.hide();
                    }
                } catch (err) {
                    categoryModalAlert.textContent = err.message;
                    categoryModalAlert.classList.remove('d-none');
                } finally {
                    btnSaveQuickCategory.disabled = false;
                    btnSaveQuickCategory.textContent = 'Save & Select';
                }
            });
        });
    </script>
}
