@page "{id:int}"
@model BookLibrary.Web.Pages.Books.EditModel
@{
    ViewData["Title"] = "Edit Book";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a asp-page="Index" class="btn btn-outline-secondary btn-sm me-3">&larr; Back to Books</a>
            <h1 class="h3 mb-0">Edit Book</h1>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Title" class="form-label fw-semibold"></label>
                        <input asp-for="Input.Title" class="form-control" />
                        <span asp-validation-for="Input.Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.ISBN" class="form-label fw-semibold"></label>
                        <input asp-for="Input.ISBN" class="form-control" />
                        <span asp-validation-for="Input.ISBN" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.AuthorId" class="form-label fw-semibold"></label>
                            <select asp-for="Input.AuthorId" asp-items="Model.AuthorsList" class="form-select">
                                <option value="">-- Select Author --</option>
                            </select>
                            <span asp-validation-for="Input.AuthorId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.CategoryId" class="form-label fw-semibold"></label>
                            <select asp-for="Input.CategoryId" asp-items="Model.CategoriesList" class="form-select">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="Input.CategoryId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.PublishedYear" class="form-label fw-semibold"></label>
                            <input asp-for="Input.PublishedYear" class="form-control" type="number" />
                            <span asp-validation-for="Input.PublishedYear" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.Status" class="form-label fw-semibold"></label>
                            <select asp-for="Input.Status" asp-items="Html.GetEnumSelectList<BookLibrary.Web.Models.BookStatus>()" class="form-select">
                            </select>
                            <span asp-validation-for="Input.Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.BookNumber" class="form-label fw-semibold">
                            Book Number <span class="text-muted fw-normal small">(Optional)</span>
                        </label>
                        <input asp-for="Input.BookNumber" class="form-control" type="number" min="1" placeholder="e.g. 1, 2, 3..." />
                        <span asp-validation-for="Input.BookNumber" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
