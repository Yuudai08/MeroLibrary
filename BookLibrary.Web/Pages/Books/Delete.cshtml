@page "{id:int}"
@model BookLibrary.Web.Pages.Books.DeleteModel
@{
    ViewData["Title"] = "Delete Book";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a asp-page="Index" class="btn btn-outline-secondary btn-sm me-3">&larr; Back to Books</a>
            <h1 class="h3 text-danger mb-0">Confirm Delete Book</h1>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (Model.Book != null)
        {
            <div class="card border-danger shadow-sm mb-4">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 text-white">Are you sure you want to delete this book?</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <h4 class="h5 card-title mb-1">@Model.Book.Title</h4>
                        <p class="text-muted mb-0">ISBN: <code>@Model.Book.ISBN</code></p>
                    </div>

                    <dl class="row mb-0 border-top pt-3">
                        <dt class="col-sm-4 text-muted">Author</dt>
                        <dd class="col-sm-8">@Model.Book.AuthorName</dd>

                        <dt class="col-sm-4 text-muted">Category</dt>
                        <dd class="col-sm-8">@Model.Book.CategoryName</dd>

                        <dt class="col-sm-4 text-muted">Published Year</dt>
                        <dd class="col-sm-8">@Model.Book.PublishedYear</dd>
                    </dl>
                </div>
                <div class="card-footer bg-light d-flex justify-content-end gap-2 p-3">
                    <form method="post">
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">Delete Permanently</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
